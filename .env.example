# AppBarber — copie do DevTools → Network → Request Headers (qualquer req para apiclient.appbarber.com.br)
APPBARBER_AUTH=Basic <hash>
APPBARBER_CLIENT_ID=<client-id>
APPBARBER_DEVICE_ID=<device-id>
APPBARBER_CLIENT_CODE=<client-code>

